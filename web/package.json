{
  "name": "wawapacha-web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc --noEmit --pretty false -p test/tsconfig.typecheck.json",
    "types": "json2ts -i ../schema/dataset.schema.json -o app/types/dataset.ts --unreachableDefinitions --bannerComment='/* Generated by `bun run types` from schema/dataset.schema.json. Do not edit by hand. */' --no-style.semi --style.singleQuote --style.printWidth=100",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "ajv": "^8.20.0",
    "echarts": "^6.1.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}

{
  "name": "wawapacha-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run claims && bun run check:claims && nuxt build",
    "check:budget": "bun scripts/check-budget.ts",
    "check:claims": "bun scripts/check-claims.ts",
    "check:seo": "bun scripts/check-seo.ts",
    "claims": "bun scripts/generate-claims.ts && oxfmt --write app/data/claims.ts",
    "dev": "nuxt dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate": "bun run claims && bun run check:claims && nuxt generate",
    "lint": "oxlint .",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc --noEmit --pretty false -p test/tsconfig.typecheck.json",
    "types": "bun scripts/generate-types.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "ajv": "^8.20.0",
    "echarts": "^6.1.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "json-schema-to-typescript": "^16.0.0",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "smol-toml": "^1.9.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}

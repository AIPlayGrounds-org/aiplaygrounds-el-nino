  "components": [
    {
      "name": "Selector de periodo",
      "kind": "button",
      "refersTo": "button-range",
      "description": "Píldoras discretas; la elegida en tinta. El único control redondeado.",
      "html": "<div class=\"ds-ranges\" role=\"group\" aria-label=\"Periodo del gráfico\"><button class=\"ds-range\" type=\"button\" aria-pressed=\"false\">10 años</button><button class=\"ds-range\" type=\"button\" aria-pressed=\"true\">30 años</button><button class=\"ds-range\" type=\"button\" aria-pressed=\"false\">Todo</button></div>",
      "css": ".ds-ranges{display:inline-flex;gap:6px}.ds-range{font-family:var(--font);font-size:.9375rem;min-height:36px;padding:0 16px;border:1px solid var(--border);border-radius:999px;background:var(--paper);color:var(--text);cursor:pointer;transition:border-color .15s ease-out,background-color .15s ease-out}.ds-range:hover{border-color:var(--text)}.ds-range[aria-pressed=\"true\"]{background:var(--text);border-color:var(--text);color:var(--paper);font-weight:650}.ds-range:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Periodo pulsado",
      "kind": "button",
      "refersTo": "button-range-pressed",
      "description": "El periodo elegido: tinta invertida.",
      "html": "<button class=\"ds-range-on\" type=\"button\" aria-pressed=\"true\">30 años</button>",
